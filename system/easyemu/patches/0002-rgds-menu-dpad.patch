 std::map<SDL_JoystickID, std::shared_ptr<SDLGamepad>> SDLGamepad::sdl_gamepads;
 
+#include "input/banana_input.h"
+void SDLGamepad::PollBananaMenu()
+{
+	uint32_t buttons = 0;
+	for (const auto& entry : sdl_gamepads)
+	{
+		const auto& pad = entry.second;
+		if (pad->name() != "retrogame_joypad" || SDL_JoystickNumButtons(pad->sdl_joystick) < 17)
+			continue;
+		buttons = banana_input::Present;
+		if (pad->is_input_detecting())
+			break;
+		auto down = [&](int button) { return SDL_JoystickGetButton(pad->sdl_joystick,button)!=0; };
+		if (down(13)) buttons |= banana_input::Up;
+		if (down(14)) buttons |= banana_input::Down;
+		if (down(15)) buttons |= banana_input::Left;
+		if (down(16)) buttons |= banana_input::Right;
+		if (down(1)) buttons |= banana_input::Confirm; // printed A (east)
+		if (down(0)) buttons |= banana_input::Back;    // printed B (south)
+		if (down(2)) buttons |= banana_input::FaceUp;
+		break;
+	}
+	banana_input::menuButtons.store(buttons,std::memory_order_relaxed);
+}
