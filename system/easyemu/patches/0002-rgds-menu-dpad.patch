@@ -0,0 +1,21 @@
+#pragma once
+#include <atomic>
+#include <cstdint>
+
+// Independent native menu navigation for the RG DS built-in controller.
+namespace banana_input {
+enum Menu : uint32_t { Up=1, Down=2, Left=4, Right=8, Confirm=16,
+                       Back=32, FaceUp=64, Present=128 };
+inline std::atomic<uint32_t> menuButtons{0};
+inline bool menuPresent() { return (menuButtons.load(std::memory_order_relaxed)&Present)!=0; }
+constexpr int direction(bool negative, bool positive) {
+    return (int(positive)-int(negative))*127;
+}
+// Active-low Dreamcast D-pad bits. Physical stick wins whenever it is in use.
+template<typename Axis>
+inline void mirrorDpad(Axis& x, Axis& y, uint32_t kcode) {
+    if (x != 0 || y != 0) return;
+    x = direction(!(kcode & (1u<<6)), !(kcode & (1u<<7)));
+    y = direction(!(kcode & (1u<<4)), !(kcode & (1u<<5)));
+}
