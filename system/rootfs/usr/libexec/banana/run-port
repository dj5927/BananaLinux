#!/bin/sh
# Ports: a port's script (PortMaster's, or any .sh in roms/ports) with bash, as ROCKNIX runs them. PortMaster itself
# is the "PortMaster" entry, installed from the Store (0.5.3 on; before, its release came in the image and was put on
# the card the first time) into roms/ports/PortMaster, where it updates itself. Ports draw on the top panel (SDL's
# KMSDRM display 0: SDL_KMSDRM_FIRST, Banana's SDL patch); the optional lease leaves the other panel with Banana UI.
# /data/home, not the read-only root.
#   run-port <script>
P=/data/roms/ports
# BananaOS's hook for ports (mod_<CFW_NAME>.txt, sourced by each port's script): the pad's GUID for get_controls,
# without which every port quit at once ("Argument list too long"). Put back each time: PortMaster updates itself.
M=/usr/share/banana/portmaster/mod_BananaOS.txt
if [ -d $P/PortMaster ] && ! cmp -s $M $P/PortMaster/mod_BananaOS.txt; then
    cat $M > $P/PortMaster/mod_BananaOS.txt && echo "mod_BananaOS.txt put in PortMaster's folder"
fi
export HOME=/data/home XDG_DATA_HOME=/data/home/.local/share XDG_CONFIG_HOME=/data/home/.config XDG_RUNTIME_DIR=/run
mkdir -p $XDG_DATA_HOME $XDG_CONFIG_HOME
export SDL_KMSDRM_FIRST=${BANANA_TOP:-DSI-2} TERM=linux
# PortMaster's menu is Python with PySDL2, which finds SDL2 through ctypes.util.find_library: no ldconfig cache or
# compiler here, so it found nothing and PortMaster quit a second after starting. Its own folder says where.
export PYSDL2_DLL_PATH=/usr/lib
# PortMaster starts its splash (a LÖVE app on KMSDRM, holding DRM master) and then its menu, which stops the splash
# only after SDL is up. SDL's KMSDRM skips a device it can't be master of (SDL_KMSDRM_REQUIRE_DRM_MASTER, on by
# default), so the menu's SDL fell back to the offscreen driver and drew nowhere: a black screen. Master is taken when
# the window is made, once the splash has gone.
export SDL_KMSDRM_REQUIRE_DRM_MASTER=0
. /usr/libexec/banana/one-panel
if [ -n "${BANANA_DRM_LEASE_FD:-}" ]; then
    # Only the lease-aware SDL ABI is exposed, not the RPG engine's other
    # dependencies. Ports which bundle an incompatible SDL can use one panel.
    export LD_LIBRARY_PATH="/usr/lib/banana/ports/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
else
    one_panel_dark top
fi
export BANANA_PORT_DARK_BACKLIGHT="$ONE_PANEL_BL"
exec /usr/bin/python3 /usr/libexec/banana/port-supervisor.py "$1"
