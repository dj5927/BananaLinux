#!/bin/sh
# Standalone RPG engines; never execute a Game.exe or Libretro core.
set -eu
export LANG=C.UTF-8 LC_CTYPE=C.UTF-8
sys="$1"; entry="$2"
case "$sys" in
    easyrpg) exe=easyrpg-player ;;
    mkxp) exe=mkxp-z ;;
    *) echo "Unknown RPG system: $sys" >&2; exit 2 ;;
esac
[ -f "$entry" ] || { echo "Missing RPG project entry: $entry" >&2; exit 2; }
case "$entry" in /*) ;; *) echo "Project entry must be absolute" >&2; exit 2 ;; esac
case "$sys" in
    easyrpg) case "$(basename "$entry" | tr '[:upper:]' '[:lower:]')" in rpg_rt.ldb|*.zip|*.easyrpg) ;; *) exit 2 ;; esac ;;
    mkxp) case "$(basename "$entry" | tr '[:upper:]' '[:lower:]')" in game.ini|mkxp.json|*.rxproj|*.rvproj|*.rvproj2) ;; *) exit 2 ;; esac ;;
esac
D=${BANANA_RPG_DATA:-/data}
R=${BANANA_RPG_RUNTIME:-/usr/lib/banana/rpg}
game=$(dirname "$entry")
key=${BANANA_GAME_KEY:-$sys/$game}
hex=$(printf '%s' "$key" | od -An -tx1 | tr -d ' \n')
id=$(printf '%s' "$key" | sha256sum | cut -d ' ' -f1)
cfg="$D/banana/rpg/$sys/$id"
mkdir -p "$cfg" "$D/banana/logs" "$D/bios/easyrpg-player/Font" "$D/bios/easyrpg-player/Soundfont" "$D/bios/mkxp/fonts" "$D/bios/mkxp/soundfonts" "$D/bios/mkxp/rtp"
get() {
    awk -v k="$hex.$1" 'index($0,k " = ")==1 {v=substr($0,length(k)+4)} END{print v}' "$D/banana/rpg-per-game.conf" 2>/dev/null || :
}
asset() {
    name=$(get "$1")
    case "$name" in ''|.*|*/*|*\\*) return 0 ;; esac
    [ -f "$2/$name" ] && [ ! -L "$2/$name" ] && printf '%s' "$2/$name" || :
}
num() {
    v=$(get "$1")
    case "$v" in ''|*[!0-9]*) return 0 ;; esac
    [ "${#v}" -le 2 ] && [ "$v" -ge 8 ] && [ "$v" -le 48 ] && printf '%s' "$v" || :
}
B="$R/$sys/$exe"
[ -x "$B" ] || { echo "Standalone RPG runtime not installed: $B" >&2; exit 3; }
export BANANA_SYSTEM="$sys" BANANA_RPG_ID="$id" BANANA_RPG_CONFIG="$cfg"
export BANANA_SA_CMD="${BANANA_RA_CMD:-}"
export BANANA_SA_LAUNCHER="${BANANA_SA_LAUNCHER:-/usr/libexec/banana/run-rpg}"
export BANANA_SA_ENTRY="$entry"
# Retain one complete session log for diagnostics, including a settings restart.
if [ "${BANANA_SA_RESTARTING:-}" != 1 ]; then
    [ ! -f "$cfg/last-run.log" ] || mv -f "$cfg/last-run.log" "$cfg/previous-run.log"
    : > "$cfg/last-run.log"
fi
# The global log is convenient for SSH/SFTP; each game's log is kept separately.
printf '%s\n' "$cfg/last-run.log" > "$D/banana/logs/rpg-last-log-path.txt"
if [ "${BANANA_RPG_LOG:-1}" != 0 ]; then
    exec >> "$cfg/last-run.log" 2>&1
fi
printf 'RPG %s launch %s restart=%s\n' "$sys" "$entry" "${BANANA_SA_RESTARTING:-0}"
export SDL_VIDEODRIVER="${SDL_VIDEODRIVER:-kmsdrm}"
export SDL_KMSDRM_FIRST="${BANANA_TOP:-DSI-2}"
if [ "$SDL_VIDEODRIVER" = kmsdrm ]; then
    case "${BANANA_DRM_LEASE_FD:-}" in ''|*[!0-9]*) echo "RPG: dedicated display lease unavailable" >&2; exit 4 ;; esac
    [ -p "${BANANA_SA_CMD:-}" ] || { echo "RPG: dedicated control channel unavailable" >&2; exit 4; }
fi
export HOME="$cfg" XDG_DATA_HOME="$cfg" XDG_CONFIG_HOME="$cfg"
export LD_LIBRARY_PATH="$R/$sys/lib:$R/common/lib"
export BANANA_RPG_ENCODING="$(get encoding)"
export BANANA_RPG_FILENAME_ENCODING="$(get filename_encoding)"
case "$BANANA_RPG_FILENAME_ENCODING" in 949|932|1252|65001|'') ;; *) BANANA_RPG_FILENAME_ENCODING= ;; esac
case "$BANANA_RPG_ENCODING" in 949|932|1252|65001|'') ;; *) BANANA_RPG_ENCODING= ;; esac
if [ -z "$BANANA_RPG_FILENAME_ENCODING" ]; then
    export BANANA_RPG_FILENAME_ENCODING="$BANANA_RPG_ENCODING"
fi
cd "$game"
if [ "$sys" = easyrpg ]; then
    fonts="$D/bios/easyrpg-player/Font"; midi="$D/bios/easyrpg-player/Soundfont"
    project="$game"; save="$game"
    case "$(basename "$entry" | tr '[:upper:]' '[:lower:]')" in
        *.zip|*.easyrpg)
            project="$entry"
            # Writable saves never go into the read-only archive or share another game's path.
            save="$entry.save"
            if [ ! -d "$save" ]; then mkdir -p "$save"; fi
            ;;
    esac
    set -- --project-path "$project" --save-path "$save" --config-path "$cfg" --fullscreen --font-path "$fonts" --soundfont-path "$midi"
    v=$(get scale); case "$v" in integer) set -- "$@" --scaling integer ;; aspect) set -- "$@" --scaling nearest ;; smooth) set -- "$@" --scaling bilinear ;; esac
    v=$(asset font1 "$fonts"); [ -z "$v" ] || set -- "$@" --font1 "$v"
    v=$(asset font2 "$fonts"); [ -z "$v" ] || set -- "$@" --font2 "$v"
    v=$(num font1_size); [ -z "$v" ] || set -- "$@" --font1-size "$v"
    v=$(num font2_size); [ -z "$v" ] || set -- "$@" --font2-size "$v"
    v=$(asset soundfont "$midi")
    [ -n "$v" ] || { [ ! -f "$R/assets/TimGM6mb.sf2" ] || v="$R/assets/TimGM6mb.sf2"; }
    [ -z "$v" ] || set -- "$@" --soundfont "$v"
    v=$(get encoding); case "$v" in 932|949|1252|65001) set -- "$@" --encoding "$v" ;; esac
    export RPG2K_RTP_PATH="$D/bios/rtp/2000" RPG2K3_RTP_PATH="$D/bios/rtp/2003"
    exec "$B" "$@"
fi
export BANANA_RPG_RGSS="$(get rgss)" BANANA_RPG_SCALE="$(get scale)"
export BANANA_RPG_MIDI="$(asset soundfont "$D/bios/mkxp/soundfonts")"
export BANANA_RPG_FONT="$(asset mkxp_font "$D/bios/mkxp/fonts")"
export BANANA_RPG_FONT_HINT="$(get font_hint)"
export BANANA_RPG_FONT_SCALE="$(get font_scale)"
export BANANA_RPG_RENDER="$(get render)"
export BANANA_RPG_RESOURCE_PRELOAD="$R/mkxp/banana-filenames.rb"
export MKXP_PORTABLE_RTP_ROOT="$D/bios/mkxp/rtp"
[ ! -f "$R/assets/TimGM6mb.sf2" ] || export MKXP_PORTABLE_SOUNDFONT="$R/assets/TimGM6mb.sf2"
if [ -d "$R/mkxp/ruby/stdlib" ] && [ -d "$R/mkxp/ruby/extensions" ]; then
    export MKXP_PORTABLE_RUBY_LOADPATH="$R/mkxp/ruby/stdlib:$R/mkxp/ruby/extensions"
fi
case "$BANANA_RPG_RGSS" in 1|2|3|'') ;; *) BANANA_RPG_RGSS= ;; esac
case "$BANANA_RPG_SCALE" in aspect|integer|smooth|'') ;; *) BANANA_RPG_SCALE= ;; esac
exec "$B"
