From: BananaOS Korean contributors
Subject: [PATCH] Accept inherited DRM panel lease for standalone RPG engines

--- a/src/video/kmsdrm/SDL_kmsdrmvideo.c
+++ b/src/video/kmsdrm/SDL_kmsdrmvideo.c
@@ -68,6 +68,27 @@
 #define EGL_PLATFORM_GBM_MESA 0x31D7
 #endif
 
+/* Banana's native standalone games inherit the game panel's DRM lease.
+ * Never reopen the full card or attempt to take DRM master in that mode. */
+static int BananaLeaseFd(void)
+{
+    const char *s = SDL_getenv("BANANA_DRM_LEASE_FD");
+    char *end = NULL;
+    long fd;
+    if (!s) return -1;
+    fd = SDL_strtol(s, &end, 10);
+    if (!*s || !end || *end || fd < 3 || fd > 1048575 || fcntl((int)fd, F_GETFD) < 0)
+        return -2;
+    return (int)fd;
+}
+
+static int BananaOpenCard(const char *path)
+{
+    const int lease = BananaLeaseFd();
+    if (lease == -2) { errno = EBADF; return -1; }
+    return lease >= 0 ? fcntl(lease, F_DUPFD_CLOEXEC, 3) : open(path, O_RDWR | O_CLOEXEC);
+}
+
