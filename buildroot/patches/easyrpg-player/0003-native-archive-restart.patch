From: BananaOS Korean contributors
Subject: [PATCH] Native RPG archive, rendering and settings restart fixes

--- a/src/player.cpp
+++ b/src/player.cpp
@@ -551,6 +551,13 @@
 				auto gamefs = FileFinder::Root().Create(FileFinder::MakeCanonical(arg.Value(0), 0));
 				if (!gamefs) {
 					Output::Error("Invalid --project-path {}", arg.Value(0));
+				}
+				// Standalone archives with a unique nested project are launchable
+				// without extraction, even if the archive contains extra files.
+				if (FileFinder::IsSupportedArchiveExtension(arg.Value(0)) &&
+				    !FileFinder::IsRPG2kProject(gamefs) && !FileFinder::IsRPG2kProjectWithRenames(gamefs)) {
+					auto games=FileFinder::FindGames(gamefs,5,2);
+					if (games.size()==1) gamefs=games.front().fs;
 				}
 				FileFinder::SetGameFilesystem(gamefs);
 			}
