+// Ruby exceptions may have no backtrace (or custom exception methods).
+// Never mutate Ruby-owned strings or assume the first frame has two colons.
+static VALUE safeExceptionMethod(VALUE arg) {
+    VALUE exc=rb_ary_entry(arg,0);
+    ID method=SYM2ID(rb_ary_entry(arg,1));
+    return rb_funcall(exc,method,0);
+}
+static VALUE exceptionField(VALUE exc,const char* field) {
+    int state=0;
+    VALUE args=rb_ary_new3(2,exc,ID2SYM(rb_intern(field)));
+    VALUE result=rb_protect(safeExceptionMethod,args,&state);
+    if(state) { rb_set_errinfo(exc); return Qnil; }
+    return result;
+}
+static std::string exceptionString(VALUE v) {
+    if(!RB_TYPE_P(v,T_STRING)) return {};
+    return std::string(RSTRING_PTR(v),RSTRING_LEN(v));
+}
