 static SDL_RWops *openBundledFont()
 {
+    // Only replace the fallback font, never a font supplied by the game.
+    static const std::string external = [] {
+        const char *v = SDL_getenv("BANANA_RPG_FONT");
+        if (v && *v) {
+            TTF_Font *probe = TTF_OpenFont(v, 16);
+            if (probe) {
+                TTF_CloseFont(probe);
+                Debug() << "Banana MKXP fallback font:" << v;
+                return std::string(v);
+            }
+            Debug() << "Invalid fallback font, using bundled font:" << v;
+        }
+        return std::string();
+    }();
+    if (!external.empty())
+        if (SDL_RWops *ops=SDL_RWFromFile(external.c_str(),"rb")) return ops;
