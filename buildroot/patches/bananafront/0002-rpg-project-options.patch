From: BananaOS Korean contributors
Subject: [PATCH] RPG project options for BananaFront

--- a/src/main.c
+++ b/src/main.c
@@ -594,6 +594,10 @@
     const bool swap = bf_system_setting(DATA, ETC, "ra_swap_ab", A.system, sw, sizeof sw) && !strcmp(sw, "on");
     const bool stick = A.system && *A.system && strcmp(A.system, "n64");
     bf_input_set_pad(swap, stick);
+    if (A.system && (!strcmp(A.system,"mkxp") || !strcmp(A.system,"easyrpg"))) {
+        const char *ab=getenv("BANANA_RPG_SWAP_AB"), *xy=getenv("BANANA_RPG_SWAP_XY");
+        bf_input_set_swaps(ab && *ab ? !strcmp(ab,"on") : swap, xy && *xy ? !strcmp(xy,"on") : swap);
+    }
     if (swap || stick) bf_log("pad:%s%s", swap ? " A/B and X/Y swapped" : "", stick ? " left stick as d-pad" : "");
 }
 
@@ -680,7 +684,15 @@
     bf_env_system_dir = g_paths.system_dir;
     bf_env_save_dir = g_paths.save_dir;
     bf_mkdirs(g_paths.save_dir);
-    bf_core_options_load(A.config, g_paths.game);
+    const char* rpg_id = getenv("BANANA_RPG_ID");
+    bool rpg = A.system && (!strcmp(A.system,"mkxp") || !strcmp(A.system,"easyrpg"));
+    bf_core_options_load(A.config, rpg && rpg_id && strlen(rpg_id)==64 && strspn(rpg_id,"0123456789abcdef")==64 ? rpg_id : g_paths.game);
+    if (A.system && !strcmp(A.system,"mkxp")) {
+        const char* v = getenv("BANANA_RPG_RGSS");
+        if (v && strlen(v)==1 && *v>='1' && *v<='3')
+            bf_core_option_set("mkxp-z_rgssVersion",v);
+    }
+    if (A.system && !strcmp(A.system,"easyrpg")) A.resume_load = A.resume_save = false;
     const double t_core = bf_now_ms();
     if (!bf_core_load_game(A.rom)) { bf_core_close(); return 1; }
     const double t_game = bf_now_ms();
@@ -694,6 +706,9 @@
         static const char* const N[] = { "fit", "integer", "stretch" };
         const int s = bf_scale_load(bf_data_dir(), A.system);
         if (s >= 0) A.scale = (enum bf_scale)s;
+        const char* scale = rpg ? getenv("BANANA_RPG_SCALE") : NULL;
+        if (scale && !strcmp(scale,"integer")) A.scale = BF_SCALE_INTEGER;
+        if (scale && !strcmp(scale,"aspect")) A.scale = BF_SCALE_FIT;
         bf_log("picture size: %s (%s%s)", N[A.scale], s >= 0 ? "Quick settings, " : "the launcher's",
                s >= 0 ? (A.system && *A.system ? A.system : "no system") : "");
     }
--- a/src/input.h
+++ b/src/input.h
@@ -19,6 +19,7 @@
 // player 1's pad as Settings > Other systems > Buttons > the system has it (run-retroarch gives RetroArch the same):
 // Swap A/B and X/Y (the game's A on the pad's B ...; the hotkeys stay on the buttons as printed), and the left stick as the d-pad
 void bf_input_set_pad(bool swap_ab, bool stick_dpad);
+void bf_input_set_swaps(bool ab, bool xy);
 // the menu: raw evdev key events (code, value 1 down / 0 up; the hat as BTN_DPAD_*) queued instead of played
 void bf_input_raw(bool on);
 bool bf_input_raw_take(int* code, int* value);
--- a/src/input.c
+++ b/src/input.c
@@ -65,8 +65,9 @@
 }
 
 void bf_input_set_job_mask(uint32_t mask) { job_mask = mask; }
-static bool pad_swap_ab, pad_stick_dpad;
-void bf_input_set_pad(bool swap_ab, bool stick_dpad) { pad_swap_ab = swap_ab; pad_stick_dpad = stick_dpad; }
+static bool pad_swap_ab, pad_swap_xy, pad_stick_dpad;
+void bf_input_set_pad(bool swap_ab, bool stick_dpad) { pad_swap_ab = pad_swap_xy = swap_ab; pad_stick_dpad = stick_dpad; }
+void bf_input_set_swaps(bool ab, bool xy) { pad_swap_ab = ab; pad_swap_xy = xy; }
 
 #define BIT(a, i) (((a)[(i) / (8 * sizeof(long))] >> ((i) % (8 * sizeof(long)))) & 1)
 
@@ -302,10 +303,14 @@
     // while F is held, the game sees no buttons (F + B must not also press B in the game)
     uint32_t b = pbuttons[0];
     if (pad_stick_dpad) b |= bf_stick_dpad(paxes[0][0], paxes[0][1]);
-    if (pad_swap_ab) {
+    if (pad_swap_ab || pad_swap_xy) {
         uint32_t s = b & ~(1u << RETRO_DEVICE_ID_JOYPAD_A | 1u << RETRO_DEVICE_ID_JOYPAD_B | 1u << RETRO_DEVICE_ID_JOYPAD_X | 1u << RETRO_DEVICE_ID_JOYPAD_Y);
         for (int id = 0; id < 16; id++)
-            if (b >> id & 1) s |= 1u << bf_swap_ab(id);
+            if (b >> id & 1) {
+                bool ab = id == RETRO_DEVICE_ID_JOYPAD_A || id == RETRO_DEVICE_ID_JOYPAD_B;
+                bool xy = id == RETRO_DEVICE_ID_JOYPAD_X || id == RETRO_DEVICE_ID_JOYPAD_Y;
+                s |= 1u << (((ab && pad_swap_ab) || (xy && pad_swap_xy)) ? bf_swap_ab(id) : id);
+            }
         b = s;
     }
     game_buttons[0] = hotkey_down ? 0 : b & ~job_mask;
--- a/src/menu_host.c
+++ b/src/menu_host.c
@@ -223,8 +223,10 @@
         h.grab_top = grab_top;
         h.poll = poll_ev;
         h.battery = battery;
-        h.save = save;
-        h.load = load;
+        const char* sys = getenv("BANANA_SYSTEM");
+        bool states = !(sys && !strcmp(sys,"easyrpg"));
+        h.save = states ? save : NULL;
+        h.load = states ? load : NULL;
         h.state_file = state_file;
         h.quit = quit;
         h.quit_nosave = quit_nosave;
--- a/src/menu.c
+++ b/src/menu.c
@@ -906,8 +906,8 @@
             char h[64] = "";
             switch (i) {
             case 0: snprintf(h, sizeof h, "or press F"); break;
