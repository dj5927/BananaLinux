@@ -1160,6 +1160,7 @@
         switch (sel_main) {
         case 0: play(SND_BACK); close_menu(); break;
         case 1: case 2: {
+            if ((sel_main == 1 && !H.save) || (sel_main == 2 && !H.load)) { play(SND_BACK); break; }
             scan_slots(1);
             int nb = newest_slot();
             scr = sel_main == 1 ? SC_SAVE : SC_LOAD;
