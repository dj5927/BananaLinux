# Banana: what its scripts use beyond Buildroot's busybox configuration
# the clock from the network once Wi-Fi is up (usr/libexec/banana/wifi)
CONFIG_NTPD=y
# /etc/sysctl.d/banana.conf at boot (rcS)
CONFIG_SYSCTL=y
# PortMaster (its menu checks for running processes with pgrep -f) and port scripts
CONFIG_PGREP=y
CONFIG_PKILL=y
CONFIG_TIMEOUT=y
# UTF-8 file names in SSH/SCP directory listings and BusyBox utilities.
CONFIG_LOCALE_SUPPORT=y
CONFIG_UNICODE_SUPPORT=y
CONFIG_UNICODE_USING_LOCALE=y
CONFIG_UNICODE_COMBINING_WCHARS=y
CONFIG_UNICODE_WIDE_WCHARS=y
